FROM node:22-bookworm-slim

WORKDIR /app/server
ENV NODE_ENV=production

COPY server/package*.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --omit=dev --prefer-offline --no-audit --maxsockets=5

WORKDIR /app
COPY server ./server
COPY scripts ./scripts

RUN mkdir -p /var/lib/clms && chown node:node /var/lib/clms
USER node
EXPOSE 5001
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD node -e "fetch('http://127.0.0.1:5001/api/health/ready').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "server/index.mjs"]
