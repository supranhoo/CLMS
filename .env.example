# Copy to a secret-managed environment; do not commit a populated .env file.
# demo is loopback-only and uses fictional data. staging/production require a real adapter.
CLMS_MODE=demo
CLMS_API_ADAPTER=synthetic
CLMS_BIND_HOST=127.0.0.1
CLMS_API_PORT=5001
CLMS_DATA_DIR=.local-demo
CLMS_PERSIST=true
CLMS_ALLOW_DEMO_RESET=false

# Required for CLMS_MODE=staging or production with the SQL adapter.
# Keep this in a secret file or secret manager, never in the frontend build.
# CLMS_MODE=staging
# CLMS_API_ADAPTER=sql
# CLMS_DATABASE_URL_FILE=/run/secrets/clms_sql
# Secret file contents use the driver's SQL Server connection-string format:
# Server=sql-host,1433;Database=CLMS;User Id=clms_runtime;Password=REPLACE;Encrypt=true;TrustServerCertificate=false
# PUBLIC_ORIGIN=https://clms.example.invalid
CLMS_SESSION_IDLE_SECONDS=1800
CLMS_SESSION_MAX_SECONDS=43200
# Explicit staging-only opt-in for a self-signed SQL certificate. Rejected in production.
CLMS_SQL_TRUST_CERTIFICATE=false
